<Rule language="beanshell" name="MultiThreading Doom">
  <Description>In the process of loading objects, allows child collections to be orphaned</Description>
  <Source>
    <![CDATA[

    import sailpoint.object.Application;
    import sailpoint.api.SailPointFactory;
    import sailpoint.api.SailPointContext;
    import org.apache.commons.logging.Log;
    import org.apache.commons.logging.LogFactory;
    
    private static SailPointContext staticContext;
    private static Log log = LogFactory.getLog("MultiThreadingDoom");

    private static class Set8784_Test5_Thread extends Thread {
        private boolean getApp;
        private int loop;
        private Log log = LogFactory.getLog("MultiThreadingDoom-Thread");
        public Set8784_Test5_Thread(boolean getApp, int loop) {
            this.getApp = getApp;
            this.loop = loop;
        }
        
        public void run () {
            if (staticContext == null) staticContext = SailPointFactory.createContext();
            try {
                for (int i = 0; i < this.loop; i++) {
                    //log.warn("Loop " + i);
                    try {
                        if (this.getApp) {
                            staticContext.getObjects(Application.class);
                        } else {
                            // do commit
                            staticContext.commitTransaction();
                        }
                    } catch (Throwable t) {
                        log.error(t.getMessage(), t);
                    }
                }
            } catch (Exception e) {
                log.error(e.getMessage(), e);
            }
        }
    }



        String loopStr = "1000000";
        int loop = Integer.valueOf(loopStr);
        Thread t1 = new Set8784_Test5_Thread(true, loop);
        t1.setName("GetterThread");
        Thread t2 = new Set8784_Test5_Thread(false, loop);
        t2.setName("CommitterThread");
        t1.start();
        t2.start();
 

    ]]>
    
    <!-- About 'becauseBshThatsWhy': Something goofy happens when a variable in the root namespace is
         assigned to an inner class. Bsh likes to keep that sucker around and re-execution of the rule
         leads to sadness when it tries to assign that variable again -->
  </Source>
</Rule>
